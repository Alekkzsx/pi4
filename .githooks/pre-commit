#!/bin/sh
# Git Hook Local: pre-commit

PYTHON_CMD="python"
if command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
fi

"$PYTHON_CMD" - << 'EOF'
import subprocess
import sys
import re

cmd = ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"]
result = subprocess.run(cmd, capture_output=True, text=True)
staged_files = [f.strip() for f in result.stdout.split('\n') if f.strip()]

MAX_LINES_BLOCK = 600
MAX_GLOBAL_MUTABLE_VARS = 10
IGNORED_EXTENSIONS = ('.png', '.jpg', '.jpeg', '.gif', '.ico', '.pdf', '.lock', 'package-lock.json', 'yarn.lock', '.json', '.svg')

errors = []
warnings = []

for filepath in staged_files:
    if filepath.lower().endswith(IGNORED_EXTENSIONS):
        continue
    
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
            lines = content.split('\n')
            total_lines = len(lines)
            
            if total_lines > MAX_LINES_BLOCK:
                errors.append(f"⛔ Arquivo '{filepath}' possui {total_lines} linhas! (Bloqueio acima de {MAX_LINES_BLOCK} linhas). Divida em arquivos menores.")
            elif total_lines > 400:
                warnings.append(f"⚠️ Arquivo '{filepath}' possui {total_lines} linhas (Aviso: Recomendado manter abaixo de 400 linhas).")
            
            # Checar apenas variáveis mutáveis globais soltas no escopo raiz
            root_let_vars = len(re.findall(r'^(let|var)\s+[a-zA-Z_][a-zA-Z0-9_]*\s*=', content, re.MULTILINE))
            if root_let_vars > MAX_GLOBAL_MUTABLE_VARS:
                errors.append(f"⛔ Arquivo '{filepath}' possui {root_let_vars} variáveis mutáveis globais no escopo raiz! (Limite máximo: {MAX_GLOBAL_MUTABLE_VARS}). Use encapsulamento.")
    except Exception as e:
        pass

if warnings and not errors:
    print("\n⚠️  --------------------------------------------------------")
    print("⚠️  AVISOS DE QUALIDADE DE CÓDIGO (Commit Permitido):")
    for w in warnings:
        print(f"  {w}")
    print("⚠️  --------------------------------------------------------\n")

if errors:
    print("\n❌ ========================================================")
    print("❌ COMMIT CANCELADO: VIOLAÇÃO DE ESTRUTURA DE ARQUIVO")
    print("❌ ========================================================")
    for err in errors:
        print(f"  {err}")
    print("\n💡 Dica: Evite criar arquivos monstros (> 600 linhas) ou acumular dezenas de variáveis mutáveis globais soltas.\n")
    sys.exit(1)

sys.exit(0)
EOF

exit $?
