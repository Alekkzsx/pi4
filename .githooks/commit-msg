#!/bin/sh
# =============================================================================
# Git Hook Local: commit-msg
# Valida a mensagem do commit ANTES do commit ser criado.
# Bloqueia o commit no terminal do dev se a mensagem estiver fora do padrão.
# =============================================================================

COMMIT_MSG_FILE="$1"

PYTHON_CMD="python"
if command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
fi

export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

"$PYTHON_CMD" - "$COMMIT_MSG_FILE" << 'HOOK_EOF'
import sys
import re

commit_msg_file = sys.argv[1]
try:
    with open(commit_msg_file, 'r', encoding='utf-8') as f:
        msg = f.read().strip()
except Exception:
    sys.exit(0)

first_line = msg.split('\n')[0].strip()

# Ignorar commits automáticos do Git
if first_line.startswith("Merge branch") or first_line.startswith("Merge pull request") or first_line.startswith("Revert "):
    sys.exit(0)

# ─── Configuração ───
CONVENTIONAL_COMMIT_REGEX = r'^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+'
MAX_FIRST_LINE = 72
MIN_DESCRIPTION = 10

FORBIDDEN_WORDS = [
    'wip', 'temp', 'teste', 'teste123', 'arrumando', 'ajustes',
    'changes', 'update', 'qualquer coisa', 'asdf', 'aaa', 'xxx',
    'todo', 'stuff', 'coisas', 'alteracoes', 'modificacoes',
]

errors = []

# 1. Tamanho máximo da primeira linha (convenção git: 72 chars)
if len(first_line) > MAX_FIRST_LINE:
    errors.append(f"⛔ Primeira linha tem {len(first_line)} caracteres (Limite: {MAX_FIRST_LINE}).")

# 2. Formato Conventional Commits
if not re.match(CONVENTIONAL_COMMIT_REGEX, first_line):
    errors.append("⛔ Fora do padrão Conventional Commits.")
    errors.append("   Formato esperado: type(scope): descrição clara do que foi feito")
    errors.append("   Tipos válidos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert")
else:
    parts = first_line.split(':', 1)
    description = parts[1].strip() if len(parts) > 1 else ""

    # 3. Descrição mínima
    if len(description) < MIN_DESCRIPTION:
        errors.append(f"⛔ Descrição muito curta: \"{description}\" ({len(description)} chars, mínimo: {MIN_DESCRIPTION}).")

    # 4. Palavras proibidas
    desc_lower = description.lower().strip()
    for word in FORBIDDEN_WORDS:
        if desc_lower == word or desc_lower.startswith(word + ' ') or desc_lower.endswith(' ' + word):
            errors.append(f"⛔ Mensagem vaga ou proibida (\"{description}\"). Descreva com clareza o que foi alterado.")
            break

if errors:
    print("\n❌ ══════════════════════════════════════════════════════════")
    print("❌  COMMIT BLOQUEADO: MENSAGEM DE COMMIT INVÁLIDA")
    print("❌ ══════════════════════════════════════════════════════════")
    print(f"\n  Sua mensagem: \"{first_line}\"\n")
    for err in errors:
        print(f"  {err}")
    print("\n  💡 Exemplos corretos:")
    print("     feat(auth): implementar autenticação via JWT")
    print("     fix(api): corrigir timeout na requisição de usuários")
    print("     docs: atualizar README com instruções de instalação\n")
    sys.exit(1)

sys.exit(0)
HOOK_EOF

exit $?
